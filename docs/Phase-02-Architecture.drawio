        <mxCell id="-t0YOAAG50TYeJt7aN4B-1" parent="1" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Gateway / Memory&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.agentcore_gateway.aws_bedrockagentcore_gateway.amc_tools (the AgentCore Gateway that exposes tool targets to the agent)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.agentcore_gateway.aws_bedrockagentcore_gateway_target.lambda_tool[&quot;qual-tools&quot;] (Gateway target routing to the qual-tools Lambda stub)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.agentcore_gateway.aws_bedrockagentcore_gateway_target.lambda_tool[&quot;quant-tools&quot;] (Gateway target routing to the quant-tools Lambda stub)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.agentcore_memory.aws_bedrockagentcore_memory.rfp_sessions (AgentCore Memory store for RFP session history)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.agentcore_memory.aws_bedrockagentcore_memory_strategy.semantic (semantic-recall strategy attached to the Memory store)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;DynamoDB / ECR&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.dynamodb.aws_dynamodb_table.quant_metrics (pay-per-request table replacing SQLite for fund quant metrics)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.ecr.aws_ecr_lifecycle_policy.runtime (image-expiry policy for the runtime&#39;s ECR repo)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.ecr.aws_ecr_repository.runtime (ECR repo to hold the orchestrator&#39;s container image, created ahead of any image push)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;IAM&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.iam.aws_iam_role.gateway (execution role assumed by the AgentCore Gateway)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.iam.aws_iam_role.kb_ingestion_sync (execution role for the (not-yet-deployed-this-pass) ingestion-sync Lambda)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.iam.aws_iam_role.knowledge_base (role Bedrock Knowledge Base assumes to read S3/write vectors, pre-created for a later pass)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.iam.aws_iam_role.lambda_execution (shared execution role for the quant/qual tool Lambdas)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.iam.aws_iam_role.runtime (execution role assumed by the AgentCore Runtime container, pre-created for a later pass)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.iam.aws_iam_role_policy.gateway (inline policy granting the Gateway role its permissions)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.iam.aws_iam_role_policy.kb_ingestion_sync (inline policy granting the ingestion Lambda S3/SQS/Bedrock access)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.iam.aws_iam_role_policy.knowledge_base (inline policy granting the KB role S3/vector-store access)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.iam.aws_iam_role_policy.lambda_execution (inline policy granting the tool Lambdas DynamoDB/logging access)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.iam.aws_iam_role_policy.runtime (inline policy granting the Runtime role Bedrock/DynamoDB/KB access)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Lambda tools&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.lambda_tools.aws_cloudwatch_log_group.tool[&quot;qual-tools&quot;] (log group for the qual-tools Lambda stub)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.lambda_tools.aws_cloudwatch_log_group.tool[&quot;quant-tools&quot;] (log group for the quant-tools Lambda stub)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.lambda_tools.aws_lambda_function.tool[&quot;qual-tools&quot;] (placeholder Lambda target for qualitative-tool Gateway routing)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.lambda_tools.aws_lambda_function.tool[&quot;quant-tools&quot;] (placeholder Lambda target for quantitative-tool Gateway routing)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Observability&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.observability.aws_cloudwatch_dashboard.amc_orchestrator (CloudWatch dashboard summarizing system health)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.observability.aws_cloudwatch_log_group.gateway (log group for AgentCore Gateway activity)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.observability.aws_cloudwatch_log_group.runtime (log group for AgentCore Runtime activity)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.observability.aws_cloudwatch_metric_alarm.dynamodb_throttles (alarm on DynamoDB throttled requests)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.observability.aws_cloudwatch_metric_alarm.lambda_errors[&quot;amc-orchestrator-dev-qual-tools&quot;] (alarm on qual-tools Lambda errors)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.observability.aws_cloudwatch_metric_alarm.lambda_errors[&quot;amc-orchestrator-dev-quant-tools&quot;] (alarm on quant-tools Lambda errors)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.observability.aws_sns_topic.alarms (shared SNS topic all alarms notify)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;S3 (KB docs)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.s3_kb_docs.aws_s3_bucket.docs (bucket to hold source commentary documents for the future KB)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.s3_kb_docs.aws_s3_bucket_lifecycle_configuration.docs (lifecycle rules for the docs bucket)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.s3_kb_docs.aws_s3_bucket_policy.docs (bucket policy restricting access to the docs bucket)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.s3_kb_docs.aws_s3_bucket_public_access_block.docs (blocks all public access to the docs bucket)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.s3_kb_docs.aws_s3_bucket_server_side_encryption_configuration.docs (default SSE-AES256 encryption on the docs bucket)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.s3_kb_docs.aws_s3_bucket_versioning.docs (enables versioning so future ingestion can track doc changes)&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="900" width="1160" x="2400" y="660" as="geometry" />
        </mxCell>
        <mxCell id="-t0YOAAG50TYeJt7aN4B-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;S3 Vectors (vector store for the KB)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.s3_vectors[0].aws_s3vectors_vector_bucket.kb_vectors (vector bucket backing the Knowledge Base)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.s3_vectors[0].aws_s3vectors_index.kb_vector_index (1024-dim cosine vector index inside the bucket)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Knowledge Base&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.knowledge_base[0].aws_bedrockagent_knowledge_base.fund_commentary (Bedrock KB backing qual_narrative_pull&#39;s RAG retrieval)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.knowledge_base[0].aws_bedrockagent_data_source.fund_commentary_docs (S3 data source wired to the docs bucket)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;KB ingestion sync (auto-syncs S3 uploads/deletes into the Knowledge Base)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.kb_ingestion_sync[0].aws_sqs_queue.events (receives S3 object-created/removed notifications)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.kb_ingestion_sync[0].aws_sqs_queue.dlq (dead-letter queue after 3 failed sync attempts)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.kb_ingestion_sync[0].aws_sqs_queue_policy.events (lets the docs bucket publish onto the events queue)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.kb_ingestion_sync[0].aws_s3_bucket_notification.docs (wires docs-bucket S3 events to the SQS queue)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.kb_ingestion_sync[0].aws_lambda_function.ingestion_sync (calls bedrock-agent:StartIngestionJob on new/changed docs)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.kb_ingestion_sync[0].aws_cloudwatch_log_group.ingestion_sync (log group for the ingestion-sync Lambda)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.kb_ingestion_sync[0].aws_lambda_event_source_mapping.events (batches SQS events into Lambda invocations)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Observability&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.observability.aws_cloudwatch_metric_alarm.kb_ingestion_dlq_depth[0] (alarm on messages stuck in the KB ingestion DLQ)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- module.observability.aws_cloudwatch_metric_alarm.lambda_errors[&quot;amc-orchestrator-dev-kb-ingestion-sync&quot;] (alarm on ingestion-sync Lambda errors)&lt;/font&gt;&lt;/div&gt;" vertex="1">
